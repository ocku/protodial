#compdef protodial
# zsh completion for protodial; generated by `protodial completion zsh`.
if (( ! $+functions[compdef] )); then
    autoload -Uz compinit
    compinit -D
fi

_protodial()
{
    local value description append_space
    local -a completion_words values descriptions
    local -a continuing_values continuing_descriptions
    completion_words=("${words[@]}")
    if (( ${+PREFIX} && ${+SUFFIX} )); then
        completion_words[CURRENT]=$PREFIX
    fi
    while IFS= read -r -d '' value \
        && IFS= read -r -d '' description \
        && IFS= read -r -d '' append_space; do
        if [[ $append_space == 0 ]]; then
            continuing_values+=("$value")
            continuing_descriptions+=("$description")
        else
            values+=("$value")
            descriptions+=("$description")
        fi
    done < <(printf '%s\0' "${completion_words[@]:1}" \
        | command protodial __complete --protocol=protodial-v1 --shell zsh \
            --cursor "$((CURRENT - 2))" --words-stdin 2>/dev/null)
    (( ${#continuing_values} )) \
        && compadd -l -S '' -d continuing_descriptions -- \
            "${continuing_values[@]}"
    (( ${#values} )) && compadd -l -d descriptions -- "${values[@]}"
    return 0
}

compdef _protodial protodial
